#!/usr/bin/env bash

set -euo pipefail

launcher_path=$(readlink -f "${BASH_SOURCE[0]}")
repository_root=$(dirname "$(dirname "$launcher_path")")
runner="$repository_root/.venv/bin/deskhelm"

if [[ ! -x "$runner" ]]; then
  echo "deskhelm: synchronized source environment is unavailable" >&2
  echo "deskhelm: run 'uv sync --extra ptt --locked' in $repository_root" >&2
  exit 1
fi

# Since the switch-over the v2 hosts own their sockets, the PTY relay, and the
# two-press Ctrl-C guard, and the working directory is preserved by exec. This
# launcher only adds the encrypted voice settings when voice is asked for.
voice_enabled=false
case ${1-} in
  voice | codex | alpha)
    [[ ${1-} == voice ]] && voice_enabled=true
    for argument in "${@:2}"; do
      case "$argument" in
        -h | --help)
          exec "$runner" "$@"
          ;;
        --voice)
          voice_enabled=true
          ;;
      esac
    done
    ;;
esac

if [[ $voice_enabled == false ]]; then
  exec "$runner" "$@"
fi

if ! command -v project-secrets >/dev/null 2>&1; then
  echo "deskhelm: project-secrets is required for local voice" >&2
  exit 1
fi

# The Codex host's relay redacts these values from the TUI output.
exec project-secrets \
  --project "$repository_root" \
  run \
  --env default \
  --require \
  DESKHELM_ALPHA_VOICE_SOURCE \
  DESKHELM_ALPHA_ASR_MODEL_DIRECTORY \
  DESKHELM_ALPHA_TTS_DIRECTORY \
  -- \
  "$runner" "$@"
